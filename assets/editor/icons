    pygame.draw.rect(icon, BLACK, (ICON_PADDING + 4, ICON_PADDING + 4, ICON_SIZE - 8, ICON_SIZE - 8), 2)
    pygame.draw.rect(icon, BLACK, (ICON_PADDING + 8, ICON_PADDING + 8, ICON_SIZE - 16, ICON_SIZE - 16), 2)
    save_icon(icon, 'copy')

# Create paste icon
def create_paste_icon():
    icon = create_icon_surface()
    pygame.draw.rect(icon, BLACK, (ICON_PADDING, ICON_PADDING, ICON_SIZE, ICON_SIZE), 2)
    pygame.draw.rect(icon, BLACK, (ICON_PADDING + 4, ICON_PADDING + 4, ICON_SIZE - 8, ICON_SIZE - 8), 2)
    pygame.draw.rect(icon, BLACK, (ICON_PADDING + 8, ICON_PADDING + 8, ICON_SIZE - 16, ICON_SIZE - 16), 2)
    pygame.draw.line(icon, BLACK, (ICON_PADDING + ICON_SIZE - 4, ICON_PADDING + 4), (ICON_PADDING + ICON_SIZE - 4, ICON_PADDING + ICON_SIZE - 4), 2)
    pygame.draw.line(icon, BLACK, (ICON_PADDING + 4, ICON_PADDING + ICON_SIZE - 4), (ICON_PADDING + ICON_SIZE - 4, ICON_PADDING + ICON_SIZE - 4), 2)
    save_icon(icon, 'paste')

# Create undo icon
def create_undo_icon():
    icon = create_icon_surface()
    pygame.draw.rect(icon, BLACK, (ICON_PADDING, ICON_PADDING, ICON_SIZE, ICON_SIZE), 2)
    pygame.draw.polygon(icon, BLACK, [(ICON_PADDING + 4, ICON_PADDING + ICON_SIZE // 2), (ICON_PADDING + ICON_SIZE // 2, ICON_PADDING + 4), (ICON_PADDING + ICON_SIZE // 2, ICON_PADDING + ICON_SIZE - 4)], 2)
    pygame.draw.line(icon, BLACK, (ICON_PADDING + ICON_SIZE // 2, ICON_PADDING + 4), (ICON_PADDING + ICON_SIZE - 4, ICON_PADDING + 4), 2)
    save_icon(icon, 'undo')

# Create redo icon
def create_redo_icon():
    icon = create_icon_surface()
    pygame.draw.rect(icon, BLACK, (ICON_PADDING, ICON_PADDING, ICON_SIZE, ICON_SIZE), 2)
    pygame.draw.polygon(icon, BLACK, [(ICON_PADDING + ICON_SIZE - 4, ICON_PADDING + ICON_SIZE // 2), (ICON_PADDING + ICON_SIZE // 2, ICON_PADDING + 4), (ICON_PADDING + ICON_SIZE // 2, ICON_PADDING + ICON_SIZE - 4)], 2)
    pygame.draw.line(icon, BLACK, (ICON_PADDING + ICON_SIZE // 2, ICON_PADDING + ICON_SIZE - 4), (ICON_PADDING + 4, ICON_PADDING + ICON_SIZE - 4), 2)
    save_icon(icon, 'redo')

# Create zoom in icon
def create_zoom_in_icon():
