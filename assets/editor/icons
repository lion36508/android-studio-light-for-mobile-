# Create zoom out icon
def create_zoom_out_icon():
    icon = create_icon_surface()
    pygame.draw.rect(icon, BLACK, (ICON_PADDING, ICON_PADDING, ICON_SIZE, ICON_SIZE), 2)
    pygame.draw.line(icon, BLACK, (ICON_PADDING + 4, ICON_PADDING + ICON_SIZE // 2), (ICON_PADDING + ICON_SIZE - 4, ICON_PADDING + ICON_SIZE // 2), 2)
    pygame.draw.rect(icon, BLACK, (ICON_PADDING + 8, ICON_PADDING + 8, ICON_SIZE - 16, ICON_SIZE - 16), 2)
    save_icon(icon, 'zoom_out')

# Create grid icon
def create_grid_icon():
    icon = create_icon_surface()
    pygame.draw.rect(icon, BLACK, (ICON_PADDING, ICON_PADDING, ICON_SIZE, ICON_SIZE), 2)
    for i in range(1, 4):
        pygame.draw.line(icon, BLACK, (ICON_PADDING, ICON_PADDING + i * ICON_SIZE // 4), (ICON_PADDING + ICON_SIZE, ICON_PADDING + i * ICON_SIZE // 4), 1)
        pygame.draw.line(icon, BLACK, (ICON_PADDING + i * ICON_SIZE // 4, ICON_PADDING), (ICON_PADDING + i * ICON_SIZE // 4, ICON_PADDING + ICON_SIZE), 1)
    save_icon(icon, 'grid')

# Create settings icon
def create_settings_icon():
    icon = create_icon_surface()
    pygame.draw.rect(icon, BLACK, (ICON_PADDING, ICON_PADDING, ICON_SIZE, ICON_SIZE), 2)
    pygame.draw.rect(icon, BLACK, (ICON_PADDING + 4, ICON_PADDING + 4, ICON_SIZE - 8, ICON_SIZE - 8), 2)
    pygame.draw.rect(icon, BLACK, (ICON_PADDING + 8, ICON_PADDING + 8, ICON_SIZE - 16, ICON_SIZE - 16), 2)
    pygame.draw.line(icon, BLACK, (ICON_PADDING + ICON_SIZE // 2, ICON_PADDING + 4), (ICON_PADDING + ICON_SIZE // 2, ICON_PADDING + ICON_SIZE - 4), 2)
    pygame.draw.line(icon, BLACK, (ICON_PADDING + 4, ICON_PADDING + ICON_SIZE // 2), (ICON_PADDING + ICON_SIZE - 4, ICON_PADDING + ICON_SIZE // 2), 2)
    save_icon(icon, 'settings')

# Create help icon
def create_help_icon():
    icon = create_icon_surface()
    pygame.draw.rect(icon, BLACK, (ICON_PADDING, ICON_PADDING, ICON_SIZE, ICON_SIZE), 2)
    pygame.draw.circle(icon, BLACK, (ICON_PADDING + ICON_SIZE // 2, ICON_PADDING + ICON_SIZE // 2), ICON_SIZE // 4, 2)
    pygame.draw.line(icon, BLACK, (ICON_PADDING + ICON_SIZE // 2, ICON_PADDING + ICON_SIZE // 2), (ICON_PADDING + ICON_SIZE // 2, ICON_PADDING + ICON_SIZE - 4), 2)
    pygame.draw.circle(icon, BLACK, (ICON_PADDING + ICON_SIZE // 2, ICON_PADDING + ICON_SIZE - 4), 2, 0)
    save_icon(icon, 'help')

# Create all icons
create_new_icon()
create_open_icon()
create_save_icon()
create_cut_icon()
create_copy_icon()
create_paste_icon()
create_undo_icon()
create_redo_icon()
create_zoom_in_icon()
create_zoom_out_icon()
create_grid_icon()
create_settings_icon()
create_help_icon()

# Quit pygame
pygame.quit()