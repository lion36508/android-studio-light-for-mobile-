import pygame
import os

# Initialize pygame
pygame.init()

# Define colors
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
GRAY = (128, 128, 128)
RED = (255, 0, 0)
GREEN = (0, 255, 0)
BLUE = (0, 0, 255)

# Define icon dimensions
ICON_SIZE = 32
ICON_PADDING = 4

# Create directory if it doesn't exist
os.makedirs('assets/editor/icons', exist_ok=True)

# Function to create a new surface with padding
def create_icon_surface():
    return pygame.Surface((ICON_SIZE + 2 * ICON_PADDING, ICON_SIZE + 2 * ICON_PADDING), pygame.SRCALPHA)

# Function to save icon
def save_icon(surface, filename):
    pygame.image.save(surface, f'assets/editor/icons/{filename}.png')

# Create new icon
def create_new_icon():
    icon = create_icon_surface()
    pygame.draw.rect(icon, BLACK, (ICON_PADDING, ICON_PADDING, ICON_SIZE, ICON_SIZE), 2)
    pygame.draw.line(icon, BLACK, (ICON_PADDING + ICON_SIZE // 2, ICON_PADDING), (ICON_PADDING + ICON_SIZE // 2, ICON_PADDING + ICON_SIZE), 2)
    pygame.draw.line(icon, BLACK, (ICON_PADDING, ICON_PADDING + ICON_SIZE // 2), (ICON_PADDING + ICON_SIZE, ICON_PADDING + ICON_SIZE // 2), 2)
    save_icon(icon, 'new')

# Create open icon
def create_open_icon():
    icon = create_icon_surface()
    pygame.draw.rect(icon, BLACK, (ICON_PADDING, ICON_PADDING, ICON_SIZE, ICON_SIZE), 2)
    pygame.draw.rect(icon, BLACK, (ICON_PADDING + 4, ICON_PADDING + 4, ICON_SIZE - 8, ICON_SIZE - 8), 2)
    pygame.draw.rect(icon, BLACK, (ICON_PADDING + 8, ICON_PADDING + 8, ICON_SIZE - 16, ICON_SIZE - 16), 2)
    save_icon(icon, 'open')

# Create save icon
def create_save_icon():
    icon = create_icon_surface()
    pygame.draw.rect(icon, BLACK, (ICON_PADDING, ICON_PADDING, ICON_SIZE, ICON_SIZE), 2)
    pygame.draw.rect(icon, BLACK, (ICON_PADDING + 4, ICON_PADDING + 4, ICON_SIZE - 8, ICON_SIZE - 8), 2)
    pygame.draw.rect(icon, BLACK, (ICON_PADDING + 8, ICON_PADDING + 8, ICON_SIZE - 16, ICON_SIZE - 16), 2)
    pygame.draw.line(icon, BLACK, (ICON_PADDING + ICON_SIZE - 4, ICON_PADDING + 4), (ICON_PADDING + ICON_SIZE - 4, ICON_PADDING + ICON_SIZE - 4), 2)
    pygame.draw.line(icon, BLACK, (ICON_PADDING + 4, ICON_PADDING + ICON_SIZE - 4), (ICON_PADDING + ICON_SIZE - 4, ICON_PADDING + ICON_SIZE - 4), 2)
    save_icon(icon, 'save')

# Create cut icon
def create_cut_icon():
    icon = create_icon_surface()
    pygame.draw.rect(icon, BLACK, (ICON_PADDING, ICON_PADDING, ICON_SIZE, ICON_SIZE), 2)
    pygame.draw.line(icon, BLACK, (ICON_PADDING + 4, ICON_PADDING + ICON_SIZE - 4), (ICON_PADDING + ICON_SIZE - 4, ICON_PADDING + 4), 2)
    save_icon(icon, 'cut')

